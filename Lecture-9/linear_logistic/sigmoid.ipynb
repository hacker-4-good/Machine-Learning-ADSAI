   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import time\n",
    "def sigmoid(series):\n",
    "   return 1/(1+np.exp(-series))\n",
    "arr = np.arange(-10, 10)\n",
    "ans = sigmoid(arr)\n",
    "plt.plot(ans)\n",
    "plt.title(\"Sigmoid Plot\")\n",
    "plt.show()"
   ]
  }
